# verify/run-probe.sh's build products, regenerated on every verify.
verify/*.o
verify/*.wasm

# The archives as they ship: gzipped, one file each (scripts/pack-out.mjs makes them, and
# src/asset-receipts.js is the committed pin). out/lib/*.a itself is committed on purpose —
# it is what the pipeline writes, and it takes an hour to rebuild.
out/lib/*.a.gz
